pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "iamajjayya/automation_framework:teastin_main"
        DOCKERHUB_CREDENTIALS = "dockerhub-creds" // Jenkins credentials ID
        DOCKERHUB_REPO = "iamajjayya/automation_framework"
        BROWSER = "chrome" // default browser for tests
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'teastin_main',
                    url: 'https://github.com/iamajjayya/Automation_framework.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Build Docker image using Docker Pipeline plugin
                    docker.build(DOCKER_IMAGE)
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    // Run tests inside the Docker container
                    docker.image(DOCKER_IMAGE).inside("-e BROWSER=${BROWSER}") {
                        sh 'pytest -s -v --html=./Reports/report.html testCases/'
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    // Login and push to Docker Hub
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDENTIALS) {
                        docker.image(DOCKER_IMAGE).push()
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished!"
        }
        success {
            echo "Pipeline succeeded!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
