pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'teastin_main', url: 'https://github.com/iamajjayya/Automation_framework.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install --upgrade pip
                pip install -r requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                . venv/bin/activate
                pytest -s -v --html=./Reports/report.html testCases/
                '''
            }
        }
    }

    post {
        always {
            echo "Pipeline finished!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
