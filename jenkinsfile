pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "iamajjayya/automation_framework:teastin_main"
        BROWSER = "chrome"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'teastin_main',
                    url: 'https://github.com/iamajjayya/Automation_framework.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE} ."
            }
        }

        stage('Run Tests') {
            steps {
                sh "docker run --rm -e BROWSER=${BROWSER} ${DOCKER_IMAGE} pytest -s -v --html=./Reports/report.html testCases/"
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
                    sh """
                        echo $PASSWORD | docker login -u $USERNAME --password-stdin
                        docker push ${DOCKER_IMAGE}
                    """
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
