pipeline {
    agent any

    environment {
        BROWSER = "chrome"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'teastin_main',
                    url: 'https://github.com/iamajjayya/Automation_framework.git'
            }
        }

        stage('Install Requirements') {
            steps {
                sh 'pip install --upgrade pip'
                sh 'pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh "pytest -s -v --html=./Reports/report.html testCases/ --browser ${BROWSER}"
            }
        }
    }

    post {
        always {
            echo "Pipeline finished!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
