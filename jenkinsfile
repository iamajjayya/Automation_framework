pipeline {
    agent {
        docker { image 'python:3.10' }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh '''
                  python3 -m venv venv
                  . venv/bin/activate
                  pip install -r requirements.txt
                '''
            }
        }
        stage('Run Tests') {
            steps {
                sh '''
                  . venv/bin/activate
                  pytest
                '''
            }
        }
    }
}
